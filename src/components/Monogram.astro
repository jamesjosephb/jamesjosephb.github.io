---
/** "jb▍" monogram: Bricolage lowercase with a lime block cursor. */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  blink?: boolean;
}
const { size = 'sm', blink = false } = Astro.props;
---

<span class:list={['monogram', size, { blink }]} aria-hidden="true">jb<span class="cursor"></span></span>

<style>
  .monogram {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text);
  }
  .sm {
    font-size: 1.5rem;
  }
  .md {
    font-size: 2.5rem;
  }
  .lg {
    font-size: 6rem;
  }
  .cursor {
    display: inline-block;
    width: 0.32em;
    height: 0.78em;
    margin-left: 0.06em;
    background: var(--accent);
    transform: translateY(0.06em);
  }
  @media (prefers-reduced-motion: no-preference) {
    .blink .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
