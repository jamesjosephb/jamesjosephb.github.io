---
/**
 * Light/dark switch. The page's inline head script sets data-theme before paint: the visitor's saved choice, or dark
 * by default. A click saves the new choice. The system colour scheme is not consulted.
 */
---

<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="true" data-theme-toggle>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[data-theme-color]');
  const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
  const sync = () => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(current() === 'dark')));
    themeColor?.setAttribute('content', current() === 'dark' ? '#0E1720' : '#EDF1F4');
  };

  function apply(theme: string) {
    root.classList.add('theme-switching');
    root.dataset.theme = theme;
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
    sync();
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {}
      apply(next);
    }),
  );

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--t-hover) var(--ease);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
  /* Dark unless explicitly light (the same rule as tokens.css): the sun offers light mode, the moon dark mode. */
  .moon {
    display: none;
  }
  :global(:root[data-theme='light']) .moon {
    display: block;
  }
  :global(:root[data-theme='light']) .sun {
    display: none;
  }
</style>
