---
/** One step inside <Steps>. The body (default slot) can hold paragraphs and a code snippet. */
interface Props {
  n: number;
  title: string;
}
const { n, title } = Astro.props;
---

<li class="step" data-step={n}>
  <p class="num" aria-hidden="true">{String(n).padStart(2, '0')}</p>
  <h3>
    <span class="sr-only">Step {n}: </span>{title}
  </h3>
  <div class="body">
    <slot />
  </div>
</li>

<style>
  .step {
    position: relative;
    margin: 0;
    padding: var(--s-5) 0 var(--s-5) 3.25rem;
    border-left: 2px solid var(--border);
    margin-left: 1rem;
    padding-left: 2.25rem;
    transition: border-color var(--t-ui) var(--ease);
  }
  .step:last-child {
    border-left-color: var(--gate);
  }
  .num {
    position: absolute;
    left: -1rem;
    top: var(--s-5);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin: 0;
    border-radius: 999px;
    background: var(--accent-fill);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  h3 {
    margin-bottom: var(--s-3);
    padding-top: 0.2rem;
  }
  .body :global(p) {
    color: var(--muted);
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .body :global(.expressive-code) {
    margin-top: var(--s-4);
  }
  /* Live (JS): only the step being read gets the lime marker. Text keeps full contrast. */
  :global(.is-live) .step .num {
    background: var(--surface-2);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    transition:
      background var(--t-ui) var(--ease),
      color var(--t-ui) var(--ease);
  }
  :global(.is-live) .step.is-current .num {
    background: var(--accent-fill);
    color: var(--on-accent);
    box-shadow: none;
  }
  :global(.is-live) .step.is-current {
    border-left-color: var(--accent);
  }
  :global(.is-live) .step:last-child.is-current {
    border-left-color: var(--gate);
  }
  @media (min-width: 960px) {
    .step {
      padding-block: var(--s-7);
      min-height: 38vh;
    }
    .num {
      top: var(--s-7);
    }
  }
</style>
