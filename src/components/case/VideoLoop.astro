---
/**
 * <VideoLoop>: a short muted screen recording in a site-drawn frame.
 * - With JS and motion allowed: plays muted and looped while on screen, pauses off screen, has a visible pause button.
 * - With reduced motion: shows the poster and a play button; nothing moves until the viewer asks.
 * - Without JS: native controls, no autoplay.
 * - A text transcript goes in the default slot (shown in a <details> under the caption).
 * With no `mp4`/`webm` yet, it renders a dev-only MediaSlot so the live page never shows an empty box.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Frame from '../Frame.astro';
import MediaSlot from './MediaSlot.astro';

interface Props {
  /** Shot-list ID, e.g. "R1". */
  id: string;
  mp4?: string;
  webm?: string;
  poster?: ImageMetadata | string;
  width?: number;
  height?: number;
  /** What the recording shows (used as the video's accessible name). */
  label: string;
  /** Visible caption: what to notice. */
  caption: string;
  frame?: 'editor' | 'browser' | 'terminal';
  frameTitle?: string;
  wide?: boolean;
}

const { id, mp4, webm, poster, width = 1280, height = 800, label, caption, frame = 'editor', frameTitle, wide = false } =
  Astro.props;
const hasVideo = Boolean(mp4 || webm);
const posterSrc =
  typeof poster === 'string' || !poster ? poster : (await getImage({ src: poster, width: 1280, format: 'webp' })).src;
const hasTranscript = Astro.slots.has('default');
---

{
  hasVideo ? (
    <figure class:list={['video-loop', { wide }]} data-video-loop>
      <Frame kind={frame} title={frameTitle}>
        <div class="stage">
          <video
            controls
            muted
            loop
            playsinline
            preload="none"
            poster={posterSrc}
            width={width}
            height={height}
            aria-label={label}
          >
            {webm && <source src={webm} type="video/webm" />}
            {mp4 && <source src={mp4} type="video/mp4" />}
          </video>
          <button class="ctl" type="button" data-ctl hidden aria-label="Play recording">
            <svg class="i-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <rect x="3.5" y="3" width="3" height="10" rx="1" />
              <rect x="9.5" y="3" width="3" height="10" rx="1" />
            </svg>
            <svg class="i-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M4.5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.4 2.7a.6.6 0 0 0-.9.5Z" />
            </svg>
          </button>
        </div>
      </Frame>
      <figcaption>
        {caption}
        {hasTranscript && (
          <details class="transcript">
            <summary>Transcript</summary>
            <slot />
          </details>
        )}
      </figcaption>
    </figure>
  ) : (
    <MediaSlot id={id} kind="recording" caption={`${label}. Caption: ${caption}`} />
  )
}

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-video-loop]').forEach((root) => {
    const video = root.querySelector('video');
    const ctl = root.querySelector<HTMLButtonElement>('[data-ctl]');
    if (!video || !ctl) return;
    video.removeAttribute('controls');
    ctl.hidden = false;
    // The viewer's last choice wins over autoplay.
    let wanted = !reduce.matches;
    let visible = false;

    const sync = () => {
      const playing = !video.paused;
      ctl.dataset.state = playing ? 'playing' : 'paused';
      ctl.setAttribute('aria-label', playing ? 'Pause recording' : 'Play recording');
    };
    const update = () => {
      if (wanted && visible && !document.hidden) video.play().catch(() => {});
      else video.pause();
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    ctl.addEventListener('click', () => {
      wanted = video.paused;
      if (wanted) video.play().catch(() => {});
      else video.pause();
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && video.preload === 'none') video.preload = 'auto';
      update();
    }, { threshold: 0.4 }).observe(root);
    document.addEventListener('visibilitychange', update);
    sync();
  });
</script>

<style>
  .video-loop {
    margin: var(--s-7) 0;
  }
  .wide {
    width: min(var(--w-wide), calc(100vw - 2 * var(--gutter)));
    margin-inline: calc((min(var(--w-wide), calc(100vw - 2 * var(--gutter))) - 100%) / -2);
    position: relative;
    z-index: 1;
  }
  .stage {
    position: relative;
  }
  .ctl {
    position: absolute;
    right: var(--s-3);
    bottom: var(--s-3);
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    background: rgb(23 24 27 / 0.78);
    color: #eceae4;
    cursor: pointer;
  }
  .ctl svg {
    fill: currentColor;
  }
  .ctl .i-pause,
  .ctl[data-state='playing'] .i-play {
    display: none;
  }
  .ctl[data-state='playing'] .i-pause {
    display: block;
  }
  figcaption {
    margin-top: var(--s-3);
    max-width: var(--w-prose);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .transcript {
    margin-top: var(--s-2);
    color: var(--text);
  }
  .transcript summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
