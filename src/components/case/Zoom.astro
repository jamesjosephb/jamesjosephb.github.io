---
/**
 * <Zoom>: one dialog per page that shows an enlarged screenshot from any <Shot> (links marked data-zoom).
 * Left/right arrows step through the page's screenshots; Esc, the close button or a click outside closes it.
 * Without JS the links open the image file instead.
 */
---

<dialog class="zoom-dialog" aria-label="Enlarged screenshot" data-zoom-dialog>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <div class="bar">
    <button type="button" class="nav" data-zoom-prev aria-label="Previous screenshot">←</button>
    <span class="count" aria-live="polite"></span>
    <button type="button" class="nav" data-zoom-next aria-label="Next screenshot">→</button>
    <button type="button" class="close" data-zoom-close>Close</button>
  </div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-zoom]'));
  if (dlg && links.length && typeof dlg.showModal === 'function') {
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    const count = dlg.querySelector<HTMLElement>('.count')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      const a = links[i];
      // A shot with a dark-theme variant enlarges the one the page is showing (dark unless explicitly light).
      const dark = document.documentElement.dataset.theme !== 'light' && a.dataset.darkHref;
      img.src = dark || a.href;
      img.alt = a.dataset.alt ?? '';
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      cap.textContent = a.dataset.caption ?? '';
      count.textContent = `${i + 1} of ${links.length}`;
    };
    links.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        show(n);
        dlg.showModal();
      }),
    );
    dlg.querySelector('[data-zoom-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-zoom-next]')!.addEventListener('click', () => show(i + 1));
    dlg.querySelector('[data-zoom-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      else if (e.key === 'ArrowRight') show(i + 1);
    });
    dlg.addEventListener('close', () => links[i]?.focus());
  }
</script>

<style>
  .zoom-dialog {
    width: min(1600px, calc(100vw - 24px));
    max-width: none;
    max-height: calc(100dvh - 24px);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--text);
  }
  .zoom-dialog::backdrop {
    background: rgb(8 14 20 / 0.82);
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 160px);
    object-fit: contain;
    border-radius: var(--r-md);
    background: var(--surface-2);
  }
  figcaption {
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }
  button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 1em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: 600 1rem var(--font-text);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--accent);
  }
  button:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .close {
    margin-left: auto;
  }
</style>
