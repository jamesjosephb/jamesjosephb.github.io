---
/**
 * D1: the toolkit's architecture, built in HTML/CSS (not SVG) so it reflows on a phone and every label is real text.
 * Four layers, each with one job, plus the context they read and the tools they reach. Gate marks show where a person approves.
 * Example names are from the public demo repo (fictional "Fourteener Transfers").
 */
const layers = [
  {
    name: 'Agents',
    job: 'A whole job',
    when: 'Combine skills and instructions for one end-to-end task.',
    examples: ['code-reviewer', 'story-delivery', 'pr-triage', 'correlation-triage'],
    key: 'agents',
  },
  {
    name: 'Skills',
    job: 'Repeatable procedures',
    when: 'Steps that need judgement, written down once.',
    examples: ['log-root-cause', 'regression-trace', 'repo-memory', 'local-api-wiring'],
    key: 'skills',
  },
  {
    name: 'Instructions',
    job: 'Standards',
    when: 'Rules applied to every change in matching files.',
    examples: ['security', 'safe-actions', 'csharp', 'angular', 'tests'],
    key: 'instructions',
  },
  {
    name: 'Scripts',
    job: 'The deterministic parts',
    when: 'Same input, same output: no model needed.',
    examples: ['ready', 'gauntlet', 'standup-digest', 'start-local'],
    key: 'scripts',
  },
];

const tools = [
  { name: 'GitHub', what: 'code, pull requests, reviews', gated: 'push · merge · comment' },
  { name: 'Ticket tracker', what: 'stories and bugs', gated: 'status changes' },
  { name: 'Logs', what: 'search via MCP or CLI', gated: null },
];
---

<div class="arch" data-wide role="group" aria-labelledby="d1-title">
  <p id="d1-title" class="sr-only">
    Architecture of the agent toolkit: an engineer asks an agent; agents use skills, instructions and scripts, read
    context docs and repo memory, and reach GitHub, the ticket tracker and logs. A person approves irreversible actions.
  </p>

  <div class="col you">
    <div class="you-card">
      <span class="label">You</span>
      <span class="you-line">ask in Copilot Chat</span>
    </div>
    <span class="flow" aria-hidden="true"></span>
  </div>

  <div class="col kit">
    <div class="kit-box">
      <p class="kit-head">
        <span class="mono">toolkit/</span>
        <span class="muted">versioned in git</span>
      </p>
      <ol class="layers" role="list">
        {
          layers.map((l, i) => (
            <li class:list={['layer', l.key]}>
              <div class="layer-name">
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{l.name}</span>
              </div>
              <div class="layer-job">
                <strong>{l.job}</strong>
                <span class="when">{l.when}</span>
              </div>
              <ul class="ex" role="list" aria-label={`${l.name} in the demo repo`}>
                {l.examples.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="context">
      <div class="ctx">
        <span class="label">Context docs</span>
        <span>One per service: what it owns, where its logs live, its gotchas.</span>
      </div>
      <div class="ctx">
        <span class="label">Repo memory</span>
        <span>Decisions and lessons the agents (and people) should not relearn.</span>
      </div>
    </div>
  </div>

  <div class="col tools">
    <span class="flow" aria-hidden="true"></span>
    <ul class="tool-list" role="list">
      {
        tools.map((t) => (
          <li class="tool">
            <span class="tool-name">{t.name}</span>
            <span class="tool-what">{t.what}</span>
            {t.gated ? (
              <span class="gated">
                <span class="sq" aria-hidden="true" />
                <span>
                  <span class="sr-only">Needs approval: </span>
                  {t.gated}
                </span>
              </span>
            ) : (
              <span class="ro">read-only</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="legend halo"><span class="sq" aria-hidden="true"></span> a person approves first</p>
  </div>
</div>

<style>
  .arch {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-7) 0;
    position: relative;
    z-index: 1;
  }
  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .col {
    display: grid;
    gap: var(--s-4);
    min-width: 0;
  }
  /* Arrows: down on phones, right on wide screens. */
  .flow {
    justify-self: center;
    width: 2px;
    height: 28px;
    background: var(--border);
    position: relative;
  }
  .flow::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    transform: translateX(-50%) rotate(45deg);
  }
  .you-card {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .you-line {
    font-weight: 600;
  }

  .kit-box {
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .kit-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    align-items: baseline;
    margin: 0 var(--s-2) var(--s-3);
    font-size: var(--fs-small);
  }
  .kit-head .mono {
    font-weight: 500;
  }
  .layers {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .layer {
    display: grid;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    transition:
      border-color var(--t-hover) var(--ease),
      transform var(--t-hover) var(--ease);
  }
  .layer:hover,
  .layer:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .layer.agents {
    border-color: var(--accent);
    box-shadow: inset 4px 0 0 var(--accent);
  }
  .layer-name {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
  }
  .idx {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent);
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .layer-job {
    display: grid;
    gap: 2px;
    line-height: 1.4;
  }
  .when {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .ex {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: start;
  }
  .ex li {
    margin: 0;
    padding: 1px 8px;
    border-radius: var(--r-sm);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .context {
    display: grid;
    gap: var(--s-3);
  }
  .ctx {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4);
    border: 1px dashed var(--border);
    border-radius: var(--r-md);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .tool-list {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tool {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    font-size: var(--fs-small);
    line-height: 1.4;
  }
  .tool-name {
    font-weight: 600;
    font-size: 1rem;
  }
  .tool-what {
    color: var(--muted);
  }
  .gated,
  .ro,
  .legend {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }
  .gated,
  .legend {
    color: var(--gate);
  }
  .ro {
    color: var(--muted);
  }
  .sq {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--gate);
  }
  .legend {
    margin: 0;
  }

  @media (min-width: 720px) {
    .layer {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
    .ex {
      grid-column: 2;
    }
    .context {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .arch {
      width: min(var(--w-wide), calc(100vw - 2 * var(--gutter)));
      margin-inline: calc((min(var(--w-wide), calc(100vw - 2 * var(--gutter))) - 100%) / -2);
      grid-template-columns: 13rem minmax(0, 1fr) 16rem;
      gap: 0;
      align-items: start;
    }
    .col.you,
    .col.tools {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding-top: 3.5rem;
    }
    .col.tools {
      grid-template-columns: auto 1fr;
    }
    .col.tools .legend {
      grid-column: 2;
    }
    .flow {
      width: 40px;
      height: 2px;
      margin-inline: var(--s-2);
    }
    .flow::after {
      left: auto;
      right: -1px;
      bottom: 50%;
      transform: translateY(50%) rotate(-45deg);
    }
    .layer {
      grid-template-columns: 8.5rem minmax(0, 15rem) minmax(0, 1fr);
      align-items: center;
    }
    .ex {
      grid-column: auto;
    }
  }
</style>
