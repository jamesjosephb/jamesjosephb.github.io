---
const items = ['Charles Schwab', 'Tech lead', 'Fintech money movement', 'C#/.NET + Angular', 'GitHub Copilot agents'];
---

<div class="cred container">
  <ul aria-label="At a glance">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) 0;
    margin: 0;
    padding: var(--s-4) 0;
    list-style: none;
    border-block: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  li {
    margin: 0;
  }
  li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.9em;
    color: var(--accent);
  }
</style>
