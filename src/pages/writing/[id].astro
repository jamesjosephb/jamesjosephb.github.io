---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, type Post } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post prose">
    <header class="page-header">
      <p class="eyebrow"><a href="/writing/">Writing</a></p>
      <h1>{post.data.title}</h1>
      <p class="muted">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.draft && <span> · Draft (visible only in local dev)</span>}
      </p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .eyebrow a {
    text-decoration: none;
  }
  .body :global(h2) {
    margin-top: 2.25rem;
  }
  .body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .body :global(pre) {
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.9rem;
  }
</style>
